FROM rust:1.75 as builder
WORKDIR /usr/src/securedeck
RUN apt-get update && apt-get install -y protobuf-compiler libprotobuf-dev
COPY proto/ proto/
COPY services/killswitch/ services/killswitch/
WORKDIR /usr/src/securedeck/services/killswitch
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y libsqlite3-0 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/src/securedeck/services/killswitch/target/release/killswitch /usr/local/bin/killswitch

RUN useradd -ms /bin/bash securedeck
USER securedeck
WORKDIR /home/securedeck

EXPOSE 50053
CMD ["killswitch"]
