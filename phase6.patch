+</div>
+{{end}}
diff --git a/console/templates/layout.html b/console/templates/layout.html
new file mode 100644
--- /dev/null
+++ b/console/templates/layout.html
@@ -0,0 +1,36 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Securedeck Console</title>
+    <link rel="stylesheet" href="/static/css/style.css">
+    <!-- HTMX for SPA navigation without JS frameworks -->
+    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
+</head>
+<body hx-boost="true">
+    
+    <header class="top-nav">
+        <div style="font-weight: 600; font-size: 18px; letter-spacing: -0.02em;">
+            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="margin-right: 8px; vertical-align: middle;">
+                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
+            </svg>
+            Securedeck
+        </div>
+        
+        <nav class="nav-links">
+            <a href="/">Dashboard</a>
+            <a href="/agents">Agent Fleet</a>
+            <a href="/policies">Policies</a>
+            <a href="/audit">Audit Log</a>
+        </nav>
+        
+        <div>
+            <a href="/killswitch" class="pill-button danger" style="text-decoration: none;">Kill Switch</a>
+        </div>
+    </header>
+
+    <main id="main-content">
+        {{template "content" .}}
+    </main>
+</body>
+</html>
diff --git a/deploy/docker/Dockerfile.console b/deploy/docker/Dockerfile.console
new file mode 100644
--- /dev/null
+++ b/deploy/docker/Dockerfile.console
@@ -0,0 +1,8 @@
+FROM golang:1.21-alpine AS builder
+WORKDIR /src
+COPY . .
+RUN go build -o /bin/console ./cmd/console
+
+FROM alpine:latest
+COPY --from=builder /bin/console /usr/local/bin/
+CMD ["console"]
